# FoodBridge Environment Configuration (.env)
# Copy this file to .env and customize for your environment.

# Django Core
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RENDER_EXTERNAL_HOSTNAME=foodbridge.onrender.com
CSRF_TRUSTED_ORIGINS=https://foodbridge.onrender.com

# Database (PostgreSQL on Render via DATABASE_URL; SQLite by default locally)
DATABASE_URL=
DB_ENGINE=sqlite
# DB_NAME=foodbridge
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Google Maps API Keys
# Browser key: restrict by HTTP Referrer in Google Cloud Console (*.onrender.com/*, localhost/*)
GOOGLE_MAPS_BROWSER_API_KEY=
# Server key: restrict by API (Routes API / Distance Matrix API)
GOOGLE_MAPS_SERVER_API_KEY=

# Uploads & Email
MAX_UPLOAD_MB=5
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FoodBridge <noreply@foodbridge.local>
